# Freelay configuration. Also see ../docs/OPERATIONS.md.
# Create the parent directory for database before starting. Paths are relative
# to the process working directory, not to this configuration file.
[server]
url = "http://127.0.0.1:8080/"
host = "127.0.0.1"
port = 8080
checkpoint_freq_seconds = 10

[store]
type = "filesystem"
path = "./data/objects"

[control]
database = "./data/control.sqlite"
# Copy public keys from the plugin's "Show public key" button.
# No client private key and no persistent token-signing key belong here.
owners = []
token_ttl_seconds = 900
minimum_free_bytes = 1073741824
max_attachment_bytes = 262144000
read_only = false
# Desktop native requests do not require CORS. Add only the exact origin(s)
# needed by your mobile Obsidian runtime; neither "*" nor "null" is accepted.
allowed_origins = []

# Alternative persistent stores: replace the [store] section above.
# ==== AWS S3 ====
# [store]
# type = "aws"
# bucket = "my-bucket"
# region = "us-east-1"         # Optional, defaults to "us-east-1"
# access_key_id = "AKIA..."
# secret_access_key = "secret..."
# prefix = ""                  # Optional path prefix within bucket

# ==== Cloudflare R2 ====
# [store]
# type = "cloudflare"
# bucket = "my-bucket"
# account_id = "abc123..."
# access_key_id = "token_value"
# secret_access_key = "token_secret"
# prefix = ""                  # Optional path prefix within bucket

# ==== Backblaze B2 ====
# [store]
# type = "backblaze"
# bucket = "my-bucket"
# key_id = "key_id_here"
# application_key = "app_key_here"
# prefix = ""                  # Optional path prefix within bucket

# ==== MinIO ====
# [store]
# type = "minio"
# bucket = "my-bucket"
# endpoint = "https://minio.example.com:9000"
# access_key = "minioadmin"
# secret_key = "minioadmin"
# prefix = ""                  # Optional path prefix within bucket

# ==== Tigris ====
# [store]
# type = "tigris"
# bucket = "my-bucket"
# access_key_id = "token_value"
# secret_access_key = "token_secret"
# prefix = ""                  # Optional path prefix within bucket

# ==== Generic S3 Configuration ====
# [store]
# type = "s3"
# bucket = "freelay-docs"
# region = "us-east-1"
# endpoint = ""                 # AWS_ENDPOINT_URL_S3 (for S3-compatible services)
# path_style = false            # AWS_S3_USE_PATH_STYLE
# presigned_url_expiration = 900 # Applies to all S3-compatible store types.
# prefix = ""
# access_key_id = "AKIA..."
# secret_access_key = "secret..."
