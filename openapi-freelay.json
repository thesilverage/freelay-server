{
  "openapi": "3.1.0",
  "info": {
    "title": "Freelay control API",
    "version": "1",
    "description": "Ed25519 challenge-response and relay-scoped metadata. See docs/PROTOCOL.md for exact signed bytes and authorization rules. Data-plane routes are upstream-derived; legacy /doc/* and physical-delete routes are not exposed in integrated mode."
  },
  "servers": [
    {
      "url": "https://freelay.example/",
      "description": "Replace with the exact canonical deployment base URL, including any prefix."
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/auth/challenges": {
      "post": {
        "operationId": "challenge",
        "summary": "Create a single-use 60-second Ed25519 challenge.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "default": {
            "description": "Error. JSON errors have a stable code; malformed requests may use the framework's validation response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChallengeRequest"
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/sessions": {
      "post": {
        "operationId": "authenticate",
        "summary": "Verify proof; optionally replace the Authorization session.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Error. JSON errors have a stable code; malformed requests may use the framework's validation response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Proof"
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/session": {
      "delete": {
        "operationId": "logout",
        "summary": "Invalidate this session.",
        "responses": {
          "204": {
            "description": "Success; refresh state snapshot."
          },
          "default": {
            "description": "Error. JSON errors have a stable code; malformed requests may use the framework's validation response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
