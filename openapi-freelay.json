  "components": {
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque 15-minute session, not a scoped data capability."
      }
    },
    "schemas": {
      "Name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "At most 200 UTF-8 bytes."
      },
      "PublicKey": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{43}$",
        "description": "Canonical base64url Ed25519 public key."
      },
      "Access": {
        "type": "string",
        "enum": [
          "read",
          "write"
        ]
      },
      "ChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "publicKey": {
            "$ref": "#/components/schemas/PublicKey"
          }
        },
        "required": [
          "version",
          "publicKey"
        ]
      },
      "Challenge": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "id": {
            "type": "string"
          },
          "nonce": {
            "type": "string"
          },
          "audience": {
            "type": "string",
            "format": "uri"
          },
          "publicKey": {
            "$ref": "#/components/schemas/PublicKey"
          },
          "issuedAt": {
            "type": "integer"
          },
          "expiresAt": {
            "type": "integer"
          }
